<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <!-- Movable root frame; buttons are created in Lua under BuffPowerHeader -->
    <Frame name="BuffPowerFrame" movable="true" frameStrata="LOW" enableMouse="true" parent="UIParent" hidden="true">
        <Size x="1" y="1"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Frames>
            <!-- Drag handle: click to lock/unlock, drag to move -->
            <CheckButton name="BuffPowerAnchor" enableMouse="true" frameStrata="LOW">
                <Scripts>
                    <OnLoad>
                        self:RegisterForDrag("LeftButton")
                        self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
                    </OnLoad>
                    <OnClick>
                        BuffPower:AnchorClick(self, button, down)
                    </OnClick>
                    <OnDragStart>
                        BuffPower:DragStart(self, button)
                    </OnDragStart>
                    <OnDragStop>
                        BuffPower:DragStop(self, button)
                    </OnDragStop>
                    <OnEnter>
                        BuffPower:Anchor_OnEnter(self)
                    </OnEnter>
                    <OnLeave>
                        GameTooltip:Hide()
                    </OnLeave>
                </Scripts>
                <Size x="16" y="16"/>
                <Anchors>
                    <Anchor point="CENTER" relativeTo="$parent" relativePoint="CENTER"/>
                </Anchors>
                <NormalTexture file="Interface\AddOns\BuffPower\Icons\draghandle"/>
                <CheckedTexture file="Interface\AddOns\BuffPower\Icons\draghandle-checked"/>
            </CheckButton>
            
            <!-- Parent of the group buttons -->
            <Frame name="BuffPowerHeader" enableMouse="true" frameStrata="LOW">
                <Size x="1" y="1"/>
                <Anchors>
                    <Anchor point="CENTER" relativeTo="$parent" relativePoint="CENTER"/>
                </Anchors>
            </Frame>
        </Frames>
    </Frame>

</Ui>
